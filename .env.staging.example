PORT=5006
ENVIRONMENT=test
LOG_LEVEL=info
BODY_LIMIT_MB=25
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

DATABASE_NAME=backoffice_test
DATABASE_USER=backoffice
DATABASE_PASSWORD=backoffice
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_URL=postgres://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}
MAX_DB_CONNECTIONS=5

JWT_SIGNING_KEY=test-jwt-signing-key-do-not-use-in-production
ACCESS_TOKEN_TTL_IN_MINUTES=120
REFRESH_TOKEN_TTL_IN_MINUTES=420

BACKOFFICE_SUPER_ADMIN_USER=admin@backoffice.com
BACKOFFICE_SUPER_ADMIN_PASS=12345678

IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_AUTH_USERNAME=test
SMTP_AUTH_PASSWORD=test

REDIS_CONNECTION_URL=redis://localhost:6379
UPLOAD_PATH=tmp
EXPORT_PATH=tmp

ZEPTO_EMAIL_API_USER=
ZEPTO_EMAIL_API_KEY=

ENDPOINT=/graphql
DEPTH_LIMIT=100
COMPLEXITY_LIMIT=1000

REQUESTS_TIME_OUT_SECS=12
BODY_LIMIT_MEGA_BYTES=25

PAYSTACK_BASE_URL=
PAYSTACK_API_KEY=
PAYSTACK_API_SECRET=
